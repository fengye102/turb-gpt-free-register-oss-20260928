# 复制成 .env 后按需填写；真实凭据不要提交。
#
# 本文件由 tools/gen_env_example.py 从 webui/config_editor.py 的配置白名单生成，
# 不要手改：改完下次生成就会被覆盖（要加配置请改 EDITABLE_FIELDS）。
#
# 空值 = 使用 config/*.py 里的默认值（config.env_loader 会把空字符串当作「未配置」），
# 所以直接复制这个文件不会改变任何默认行为。

# ============================================================
# WebUI 授权
# ============================================================

# WebUI 授权码
# 仅保存在 .env（WEBUI_AUTH_CODE），避免出现在进程命令行中；保存后重启 WebUI 生效
# 敏感值：只写 .env，不写回 config/*.py
WEBUI_AUTH_CODE=

# Session 签名密钥
# 可选，保存在 .env（WEBUI_SESSION_SECRET）；不填则从固定授权码派生，修改授权码会使已有登录失效
# 敏感值：只写 .env，不写回 config/*.py
WEBUI_SESSION_SECRET=

# ============================================================
# 功能开关
# ============================================================

# 启用 Codex OAuth
# 注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=

# 启用 2FA(TOTP)
# 注册完成后自动设置动态口令（会多收一封 OTP 邮件）
ENABLE_2FA=

# 启用 Flow 触发
# 注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ============================================================
# 注册方式
# ============================================================

# 注册驱动
# 默认推荐 roxy；protocol=纯协议，容易封号不建议；roxy=RoxyBrowser；cloak=CloakBrowser；browser_use=Browser Use Cloud+Playwright；skyvern=Skyvern Browser Sessions+Playwright
REGISTRATION_DRIVER=

# 注册后自动查套餐
# 注册成功后自动入队查询套餐/Plus 资格；关闭后仅保存账号，不自动查套餐
AUTO_PLAN_CHECK_AFTER_REGISTER=

# ============================================================
# CloakBrowser
# ============================================================

# Cloak无头
# True=无头运行；False=显示浏览器窗口
CLOAK_HEADLESS=

# Cloak人工行为
# 启用 CloakBrowser humanize 鼠标/键盘/滚动行为
CLOAK_HUMANIZE=

# Cloak按出口定位
# 按当前出口 IP 自动匹配时区/语言/WebRTC IP；支持显式代理、系统代理/VPN
CLOAK_GEOIP=

# Cloak语言
# 留空自动；日本可填 ja-JP，美国 en-US
CLOAK_LOCALE=

# Cloak时区
# 留空自动；日本可填 Asia/Tokyo，美国 America/Los_Angeles
CLOAK_TIMEZONE=

# Cloak使用代理
# 把本项目传入或代理池抽取的代理传给 CloakBrowser
CLOAK_USE_PROXY=

# Cloak License
# Pro license；留空使用免费 binary
CLOAK_LICENSE_KEY=

# Cloak指纹Seed
# 留空每次随机；固定值可保持同一指纹
CLOAK_FINGERPRINT_SEED=

# Cloak用户目录
# 留空使用临时上下文；填写路径则持久化 cookies/cache
CLOAK_USER_DATA_DIR=

# Cloak超时
# 页面和元素等待超时时间，秒
CLOAK_SELENIUM_TIMEOUT=

# 保留Cloak浏览器
# 调试时开启，任务结束后不自动关闭
CLOAK_KEEP_BROWSER_OPEN=

# ============================================================
# Browser Use
# ============================================================

# Browser Use API Key
# 保存在 .env（BROWSER_USE_API_KEY），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
BROWSER_USE_API_KEY=

# 代理国家代码
# 两位国家码，如 jp/us/sg；配合 Browser Use 内置 residential proxy
BROWSER_USE_PROXY_COUNTRY_CODE=

# 使用内置代理
# True=连接参数带 proxyCountryCode；False=不强制传国家代理参数
BROWSER_USE_USE_PROXY=

# Profile ID
# 可选。填写则复用 Browser Use profile 的 cookies/localStorage；批量建议留空
BROWSER_USE_PROFILE_ID=

# CDP 地址
# 默认 wss://connect.browser-use.com
BROWSER_USE_CDP_BASE=

# 操作超时(秒)
# Playwright 默认操作超时
BROWSER_USE_TIMEOUT=

# 云端keepAlive(分钟)
# 传给 Browser Use connect URL 的 timeout/keepAlive；程序会自动限制到 1-240，建议 240
BROWSER_USE_SESSION_TIMEOUT=

# 快速模式
# 减少 Browser Use 额外等待和 humanize 延迟；建议开启，异常排查时可关闭
BROWSER_USE_FAST_MODE=

# 耗时日志
# 打印 Browser Use 各阶段耗时：连接、打开页面、邮箱、OTP、手机、callback
BROWSER_USE_LOG_TIMING=

# 保留远端会话
# 调试时可不主动 browser.close()；默认 False
BROWSER_USE_KEEP_BROWSER_OPEN=

# 起始 URL
# 默认 https://chatgpt.com/auth/login
BROWSER_USE_START_URL=

# ============================================================
# Skyvern
# ============================================================

# Skyvern API Key
# 保存在 .env（SKYVERN_API_KEY），用于创建 Skyvern Browser Session
# 敏感值：只写 .env，不写回 config/*.py
SKYVERN_API_KEY=

# API 地址
# 默认 https://api.skyvern.com
SKYVERN_API_BASE=

# Session 超时(分钟)
# 创建 Skyvern Browser Session 时传入的 timeout
SKYVERN_BROWSER_SESSION_TIMEOUT=

# Browser Profile ID
# 可选，复用 Skyvern browser profile
SKYVERN_BROWSER_PROFILE_ID=

# 代理地区
# 可填 jp/us/gb 等简写；会自动转为 Skyvern 枚举，如 jp→RESIDENTIAL_JP；留空不传
SKYVERN_PROXY_LOCATION=

# 浏览器类型
# Skyvern 支持 msedge / chrome / stealth-chromium；旧值 chromium-headful 会自动转为 stealth-chromium
SKYVERN_BROWSER_TYPE=

# 广告拦截
# 创建 Skyvern Browser Session 时启用 ad_blocker
SKYVERN_AD_BLOCKER=

# 保存浏览器Profile
# Session 结束时是否让 Skyvern 生成/保存 browser profile
SKYVERN_GENERATE_BROWSER_PROFILE=

# 保留浏览器
# 调试时可开启，任务结束后不主动关闭 Skyvern Browser Session
SKYVERN_KEEP_BROWSER_OPEN=

# 起始 URL
# 默认 https://chatgpt.com/auth/login
SKYVERN_START_URL=

# ============================================================
# RoxyBrowser
# ============================================================

# Roxy API 地址
# 默认 http://127.0.0.1:50000；需在 Roxy 应用 API 配置中开启
ROXY_API_BASE=

# Roxy API Key
# 保存在 .env（ROXY_API_TOKEN），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
ROXY_API_TOKEN=

# Roxy 环境ID
# 指定要打开的 Roxy 浏览器环境/Profile ID；留空则尝试创建临时环境
ROXY_PROFILE_ID=

# Roxy 工作区ID
# 创建一号一环境时必填，会作为 workspaceId 提交给 Roxy 创建 Profile 接口
ROXY_WORKSPACE_ID=

# Roxy 项目ID
# 从 /browser/workspace 的 project_details.projectId 获取；创建 Profile 时会作为 projectId 提交
ROXY_PROJECT_ID=

# 获取团队接口
# 默认 /browser/workspace；点击获取团队/项目时会先试此路径，再自动尝试常见兼容路径
ROXY_WORKSPACE_LIST_PATH=

# 打开接口路径
# 默认 /browser/open；如 Roxy 版本不同可在此调整
ROXY_OPEN_PATH=

# 无头启动窗口
# 打开 Roxy 环境时向 /browser/open 传 headless；False=显示窗口，True=无头启动
ROXY_OPEN_HEADLESS=

# 关闭接口路径
# 默认 /browser/close
ROXY_CLOSE_PATH=

# 保留浏览器
# 调试时可开启，任务结束后不自动关闭 Roxy 环境
ROXY_KEEP_BROWSER_OPEN=

# 一号一环境
# 每个账号强制创建新 Roxy Profile，用完关闭并删除，禁止复用固定环境
ROXY_ONE_PROFILE_PER_ACCOUNT=

# 结束后删除环境
# 一号一环境模式下，任务结束后删除本轮创建的 Roxy Profile
ROXY_DELETE_PROFILE_AFTER_RUN=

# 创建环境随机OS
# 创建 Roxy 环境时每次在 Windows / macOS 中随机，不固定 macOS
ROXY_RANDOM_OS_ON_CREATE=

# 随机OS范围
# 逗号分隔，默认 Windows,macOS；Roxy 支持 Windows / macOS / Linux / IOS / Android
ROXY_RANDOM_OS_CHOICES=

# 创建环境随机名称
# 创建 Roxy 环境时自动生成不同名称，避免固定 gpt-free-register
ROXY_RANDOM_PROFILE_NAME_ON_CREATE=

# 随机名称前缀
# 默认 rb；实际名称格式类似 rb-时间戳-随机码
ROXY_PROFILE_NAME_PREFIX=

# 创建环境使用代理池
# 创建 Roxy 环境时从配置页「代理池」随机取一个代理，写入 Roxy proxyInfo
ROXY_CREATE_USE_PROXY_POOL=

# 代理检测通道
# 写入 Roxy proxyInfo.checkChannel；留空则不传，默认 IPRust.io
ROXY_PROXY_CHECK_CHANNEL=

# 删除接口路径
# 默认 /browser/delete；如 Roxy 版本不同可调整
ROXY_DELETE_PATH=

# Codex回调超时
# Roxy Codex OAuth 等待 localhost:1455 callback 的最长秒数
ROXY_CODEX_CALLBACK_TIMEOUT=

# ============================================================
# Codex
# ============================================================

# Codex授权驱动
# 默认推荐 roxy；protocol=原协议授权；roxy=用 RoxyBrowser；cloak=用 CloakBrowser；browser_use=用 Browser Use Cloud；skyvern=用 Skyvern；same_as_registration=跟随注册驱动
CODEX_OAUTH_DRIVER=

# Agent sub2 自动同步
# 生成 Codex Agent Token 成功后自动同步到 sub2api
SUB2API_AUTO_EXPORT=

# Agent sub2 同步模式
# api=直接上传接口；file=写本地json；both=接口+本地json
SUB2API_SYNC_MODE=

# sub2 API基址
# sub2api 服务地址；Agent Token 上传和 Codex OAuth 共用，例如 http://127.0.0.1:8080
SUB2API_API_BASE=

# sub2 API Key
# sub2api 管理接口 API Key；请求头使用 x-api-key；为空则不带鉴权头
# 敏感值：只写 .env，不写回 config/*.py
SUB2API_API_KEY=

# sub2 超时
# sub2api 请求超时秒数
SUB2API_API_TIMEOUT=

# Agent sub2 本地路径
# 仅 SUB2API_SYNC_MODE=file/both 时使用；相对路径按项目根目录解析
SUB2API_OUTPUT_PATH=

# Agent sub2 代理键
# 可选；写入 account.proxy_key，并在 proxies 为空时初始化 proxies[0].proxy_key
SUB2API_PROXY_KEY=

# 授权地址来源
# cpa=CPA生成并上传CPA；sub2=sub2生成并上传sub2；local=本地PKCE
CODEX_AUTH_URL_SOURCE=

# CPA 管理地址
# 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=

# 管理密钥
# 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
CPA_MANAGEMENT_KEY=

# CPA 超时(秒)
# 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=

# 保存CPA回执
# CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ============================================================
# 人工节奏
# ============================================================

# 启用随机停顿
# 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=

# 停顿倍率
# 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=

# 浏览器动作随机化
# Roxy/Cloak 点击、输入、页面观察使用随机鼠标落点和逐字输入，降低机械操作痕迹
ENABLE_HUMANIZE_BROWSER_ACTIONS=

# ============================================================
# 邮箱 / OTP
# ============================================================

# 自动取邮箱+收码
# True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=

# 手动注册邮箱
# USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=

# 显示名称
# 留空则自动生成英文名
REGISTER_NAME=

# OTP 最长等待(秒)
# 等待验证码邮件的最长秒数，超时判失败
OTP_MAX_WAIT=

# OTP 轮询间隔(秒)
# 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=

# 邮箱来源
# 可填单个或多个，逗号分隔并按顺序兜底：outlook,generic_api,imap,cloudflare_domain,cloudflare,gptmail,mailnest,cloudmail,remail
EMAIL_SOURCE=

# 通用 IMAP 收件箱
# 通用 IMAP 邮箱默认目录，通常为 INBOX；服务器、端口、用户名和密码在邮箱池导入
IMAP_MAILBOX=

# GPTMail API Key
# 选择 gptmail 邮箱来源时必填；保存在 .env，不会写入 config 源码
# 敏感值：只写 .env，不写回 config/*.py
GPTMAIL_API_KEY=

# Cloudflare API 地址
# Worker 临时邮箱 API 根地址，如 https://mail.example.com；选择 cloudflare 时必填
# 敏感值：只写 .env，不写回 config/*.py
CLOUDFLARE_API_BASE=

# Cloudflare API Key
# 匿名可空；admin 模式填 ADMIN_PASSWORD；保存在 .env
# 敏感值：只写 .env，不写回 config/*.py
CLOUDFLARE_API_KEY=

# Cloudflare 鉴权模式
# none / bearer / x-api-key / x-admin-auth / query-key
CLOUDFLARE_AUTH_MODE=

# Cloudflare 全局密码
# Worker PASSWORDS，注入 x-custom-auth；保存在 .env
# 敏感值：只写 .env，不写回 config/*.py
CLOUDFLARE_CUSTOM_AUTH=

# Cloudflare 创建路径
# 默认 /api/new_address；admin 常用 /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=

# Cloudflare 邮件路径
# 默认 /api/mails
CLOUDFLARE_PATH_MESSAGES=

# Cloudflare 域名路径
# 默认 /api/domains（预留）
CLOUDFLARE_PATH_DOMAINS=

# Cloudflare Token路径
# 默认 /api/token（fallback 预留）
CLOUDFLARE_PATH_TOKEN=

# Cloudflare 默认域名
# 收信域名，每行一个或逗号分隔；创建时轮询使用，可留空
CLOUDFLARE_DEFAULT_DOMAINS=

# Cloudflare 请求超时(秒)
# HTTP 请求超时，默认 20
CLOUDFLARE_REQUEST_TIMEOUT=

# Cloudflare 随机名前缀长度
# admin 创建时 local-part 长度，默认 10
CLOUDFLARE_NAME_LENGTH=

# Outlook取件模式
# auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=

# 邮箱网关校验 TLS 证书
# 默认开启。关闭后取码通道可被中间人替换，仅自签证书的自建网关才关
MAIL_TLS_VERIFY=

# 转发域名(cloudflare_domain)
# Duck 隐私邮箱填 duck.com；自有 Cloudflare 域名填 mydomain.com
EMAIL_DOMAIN=

# Duck 隐私邮箱 Token
# 抓包 Authorization Bearer。有值时走 Duck API 生成 xxx@duck.com，验证码从 QQ IMAP 收
# 敏感值：只写 .env，不写回 config/*.py
DUCK_EMAIL_TOKEN=

# QQ 邮箱地址
# 仅 cloudflare_domain：接收 Email Routing 转发的 QQ 邮箱，如 123456@qq.com
QQ_EMAIL=

# QQ 邮箱 IMAP 授权码
# 仅 cloudflare_domain：QQ IMAP 授权码，保存在 .env，不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
QQ_IMAP_PASSWORD=

# MailNest API Key
# 选择 mailnest 邮箱来源时必填；保存在 .env，不会写入 config 源码
# 敏感值：只写 .env，不写回 config/*.py
MAIL_NEST_API_KEY=

# MailNest 项目代码
# 项目代码 默认 chatgpt001 获取页面 mailnest.top/buy-email
MAIL_NEST_PROJECT_CODE=

# CloudMail API 地址
# Cloud Mail Worker/API 地址，例如 https://mail.example.com
CLOUDMAIL_API_BASE=

# CloudMail管理员邮箱
# 用于生成 Token；域名被平台隐藏时也会用它登录读取域名
# 敏感值：只写 .env，不写回 config/*.py
CLOUDMAIL_ADMIN_EMAIL=

# CloudMail 密码
# 用于自动获取 Token；保存在 .env
# 敏感值：只写 .env，不写回 config/*.py
CLOUDMAIL_PASSWORD=

# CloudMail Token路径
# 固定使用 /api/public/genToken；如部署版本不同可修改
CLOUDMAIL_TOKEN_PATH=

# CloudMail Token
# CloudMail/Cloud Mail API Authorization Token；保存在 .env
# 敏感值：只写 .env，不写回 config/*.py
CLOUDMAIL_AUTH_TOKEN=

# CloudMail 域名列表
# 可留空；运行时会自动从平台获取。也可点“获取 CloudMail 域名”缓存到这里
CLOUDMAIL_DOMAINS=

# CloudMail自动创建用户
# 生成随机邮箱后调用 /api/public/addUser 创建用户
CLOUDMAIL_AUTO_ADD_USER=

# CloudMail随机名前缀长度
# 生成邮箱 local-part 的长度，建议 10-16
CLOUDMAIL_RANDOM_LOCAL_LENGTH=

# Remail API 地址
# 默认 https://remail.aishop6.com；也可填写文档地址 https://remail.aishop6.com/docs
REMAIL_API_BASE=

# Remail API Key
# Remail 控制台生成的 rk- 开头 API Key；选择 remail 来源时必填，保存在 .env
# 敏感值：只写 .env，不写回 config/*.py
REMAIL_API_KEY=

# Remail 项目 ID
# Remail API 项目列表中的 projectId，用于匹配 ChatGPT/OpenAI 验证码项目
REMAIL_PROJECT_ID=

# Remail 邮箱后缀
# 下单时使用的邮箱后缀，默认 outlook.com；不要填写完整邮箱
REMAIL_EMAIL_SUFFIX=

# Remail 服务模式
# code=短效接码；purchase=长效购买（可重复收件，默认）
REMAIL_SERVICE_MODE=

# Remail 库存策略
# private_first 优先自有库存；public_only 只使用公开库存（默认）
REMAIL_SUPPLY_POLICY=

# Remail 订单等待(秒)
# 下单后未立即返回 service token 时等待订单补齐凭证，默认 30 秒
REMAIL_ORDER_WAIT_SECONDS=

# Remail 请求超时(秒)
# Remail API 单次 HTTP 请求超时，默认 20 秒
REMAIL_REQUEST_TIMEOUT=

# ============================================================
# 浏览器画像
# ============================================================

# 地区画像
# 应与代理出口地区一致；可选 jp/cn/us/sg。当前本地代理实测为日本东京，推荐 jp
BROWSER_LOCALE_PROFILE=

# 按出口IP自动画像
# 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=

# IP定位超时(秒)
# 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=

# 本地浏览器省流量模式
# 仅 Roxy/Cloak 本地浏览器拦截图片和媒体等可选资源；Browser Use/Skyvern 云端浏览器不启用；默认关闭
BROWSER_DATA_SAVER_MODE=

# 本地浏览器省流量拦截类型
# 仅 Roxy/Cloak 生效；每行一种，默认 image、media；可选 stylesheet、font、manifest、texttrack。不要填写 script/xhr/fetch/document/websocket
BROWSER_DATA_SAVER_BLOCKED_RESOURCE_TYPES=

# 本地浏览器省流量 URL 屏蔽规则
# 仅 Roxy/Cloak 生效；每行一条 URL glob；默认拦截 RUM/广告统计和 Google GSI（不用 Google 登录时）。不要屏蔽核心 API/sentinel；填 [] 可关闭默认规则
BROWSER_DATA_SAVER_BLOCKED_URL_PATTERNS=

# 本地浏览器流量明细日志
# 仅 Roxy/Cloak 生效；注册结束时输出每个资源的 URL、类型、方法、状态码和上传/下载大小；URL 查询值会脱敏，默认关闭
BROWSER_TRAFFIC_DETAIL_LOG=

# 流量明细最多条数
# 按单请求总字节降序输出，默认 2000，最大 10000；用于后续分析可屏蔽资源
BROWSER_TRAFFIC_DETAIL_MAX_ENTRIES=

# 记录本地浏览器 JS 覆盖率
# 仅 Roxy/Cloak 生效；通过 Chrome CDP 记录本次注册实际执行的 JS 函数和 offset；Browser Use/Skyvern 不启用；默认关闭
BROWSER_JS_COVERAGE_LOG=

# 本地浏览器 JS 覆盖率最多条数
# 仅 Roxy/Cloak 生效；日志最多输出的已执行函数数，同时限制保存的脚本摘要数量，默认 1000，最大 10000
BROWSER_JS_COVERAGE_MAX_ENTRIES=

# ============================================================
# 代理池
# ============================================================

# 代理池(每行一个)
# 每行一个代理 URL，留空行会被忽略；为空则不使用代理
PROXY_POOL=

# 套餐/Agent网络模式
# 用于查套餐和生成 Agent Token；auto=本地代理可用则走代理、未监听则直连；proxy=强制代理；direct=强制直连
PLAN_CHECK_PROXY_MODE=

# 套餐/Agent专用代理
# 用于查套餐和生成 Agent Token；留空时 auto/proxy 从代理池选择。可能包含认证信息，仅保存到 .env
# 敏感值：只写 .env，不写回 config/*.py
PLAN_CHECK_PROXY=

# 套餐/Agent超时(秒)
# 查套餐和生成 Agent Token 的单次请求超时，建议 10-20 秒；独立于注册请求超时
PLAN_CHECK_TIMEOUT=

# 套餐/Agent最大尝试次数
# 查套餐和生成 Agent Token 遇到网络错误、429、5xx 等临时错误时的重试次数，建议 2 次
PLAN_CHECK_MAX_ATTEMPTS=

# 套餐/Agent重试间隔(秒)
# 查套餐和生成 Agent Token 的重试间隔，按尝试次数递增；服务端 Retry-After 优先
PLAN_CHECK_RETRY_DELAY=

# 新账号资格复查延迟(秒)
# 新注册 free 账号未发现试用资格或首次查询失败时复查一次；0 表示关闭
PLAN_CHECK_REGISTRATION_RECHECK_DELAY=

# 套餐查询并发数
# 自动、手动和批量查套餐共用；Agent Token 生成使用独立队列；建议 2-4 个线程
PLAN_CHECK_WORKERS=

# 套餐查询队列上限
# 防止异常批量操作无限堆积，建议 100-1000
PLAN_CHECK_QUEUE_LIMIT=

# 套餐/Agent请求最小间隔(秒)
# 限制查套餐和生成 Agent Token 的请求启动频率，降低 429 风险
PLAN_CHECK_MIN_INTERVAL=

# 套餐/Agent请求随机抖动(秒)
# 在查套餐和生成 Agent Token 的最小间隔上增加随机延迟，避免请求过于规律
PLAN_CHECK_JITTER=

# ============================================================
# 接码平台
# ============================================================

# 接码通道
# grizzly / l / h；l 使用 L_API.md，h 使用 H_API.md 定义的本地取号服务
SMS_PROVIDER=

# 国家代码
# 传给接码平台的 country；GrizzlySMS 常用：美国=187；H 通道作为 H_API.md 的 country
SMS_COUNTRY=

# 服务/项目代码
# GrizzlySMS/L 作为 service；H 通道作为 H_API.md 的 projectId
SMS_SERVICE=

# 换号重试次数
# 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=

# 单号等短信(秒)
# 单个号等待短信到达的最长秒数，超时则换号
SMS_CODE_WAIT=

# GrizzlySMS API密钥
# GrizzlySMS 平台 API Key，保存在 .env（SMS_API_KEY），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
SMS_API_KEY=

# H API 地址
# H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=

# H 授权码
# 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
H_ADMIN_AUTH_CODE=

# H 号码前缀
# H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=

# H 取号方式
# reusable=优先复用历史可用号码；new=每次都取一个新号码
H_PHONE_ACQUIRE_MODE=

# L API 地址
# L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=

# L 授权码
# 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
# 敏感值：只写 .env，不写回 config/*.py
L_ADMIN_AUTH_CODE=

# L 号码前缀
# L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=
